          }
        ],
        "responses": {
          "200": {
            "description": "원문 위치·선택 범위·제외 사유. 전체 원본 파일은 응답하지 않습니다."
          },
          "404": {
            "description": "작업 없음"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisResult": {
        "properties": {
          "summary": {
            "type": "string",
