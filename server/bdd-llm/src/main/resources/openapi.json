          "existing_bdd_assessment": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Existing Bdd Assessment"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/ScenarioCandidate"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Candidates"
          },
          "questions": {
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": "array",
            "title": "Questions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary",
          "existing_bdd_assessment",
          "candidates",
          "questions"
        ],
        "title": "AnalysisResult",
        "description": "LLM에 요청하고 응답에서 검사할 구조입니다. 후보 0개도 허용합니다."
      },
      "CandidateReview": {
