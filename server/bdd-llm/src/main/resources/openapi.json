    "/jobs/{id}/evidence": {
      "get": {
        "summary": "분석 당시의 명세·BDD·선택된 테스트 근거 조회",
        "operationId": "getJobEvidence",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
