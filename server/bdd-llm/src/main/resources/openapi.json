    "/events": {
      "post": {
        "summary": "오류 등록과 분석 작업 생성",
        "description": "새 작업이면 201, 기존 작업을 재사용하면 200입니다. 이 요청에서 LLM을 호출하지 않습니다.",
        "operationId": "post_event_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorEvent"
              },
              "example": {
                "event_id": "demo-event-0001",
                "service": "order-service",
                "environment": "local",
                "occurred_at": "2026-10-16T10:00:00+09:00",
                "deploy_sha": "0123456789abcdef0123456789abcdef01234567",
                "request": {
                  "method": "POST",
                  "path": "/orders",
                  "route_template": "/orders",
                  "body": {
                    "coupon_code": "EXPIRED-DEMO"
                  }
                },
                "response": {
                  "status_code": 500
                },
                "error": {
                  "type": "CouponExpiredError",
                  "message": "만료된 쿠폰을 적용하는 중 오류가 발생했습니다.",
                  "stack_trace": [
                    "order_service.py:42 in create_order",
                    "coupon_service.py:18 in validate_coupon"
                  ]
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueResult"
                }
              }
            }
          },
          "200": {
            "description": "같은 그룹·업무 조건·분석 기준의 기존 작업 재사용",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "summary": "분석 작업 상태와 결과 조회",
        "operationId": "read_job_jobs__job_id__get",
