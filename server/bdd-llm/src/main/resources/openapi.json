            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Event Id"
          },
          "service": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Service"
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Environment"
          },
